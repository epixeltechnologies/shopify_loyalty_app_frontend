APP_NAME="Shopify Loyalty App"
APP_ENV=local
APP_KEY=
# SECURITY (hardening audit): APP_DEBUG=true is only safe for LOCAL
# DEVELOPMENT. With it true, Laravel returns full stack traces, file
# paths, and query details on unhandled errors. This app's JSON API
# error responses are already independently gated on `App::isProduction()`
# rather than this flag (see ApiExceptionRenderer), but APP_DEBUG also
# affects non-API error rendering and other debug tooling — it MUST be
# `false` in staging/production regardless. Likewise, LOG_LEVEL=debug
# is verbose and appropriate for local dev only; use `warning` or
# `info` in staging/production to avoid logging excessive detail
# (and reduce the chance of sensitive data ending up in logs).
APP_DEBUG=true
APP_URL=https://your-ngrok-or-domain.example.com
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopify_loyalty
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_HORIZON_DB=2

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Shopify App Credentials ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SCOPES=read_customers,write_customers,read_orders,read_products,read_discounts,write_discounts,read_price_rules,write_price_rules,read_script_tags,write_script_tags
# How long a generated OAuth state value stays valid (seconds) — see App\Services\Shopify\OAuthStateService
SHOPIFY_OAUTH_STATE_TTL=600

# --- Billing (Shopify Managed Pricing) ---
SHOPIFY_BILLING_TEST_MODE=true
SHOPIFY_TRIAL_DAYS=0
SHOPIFY_BILLING_CURRENCY=USD
SHOPIFY_PLAN_HANDLE_STARTER=starter
SHOPIFY_PLAN_HANDLE_PROFESSIONAL=professional

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1

# --- CORS (local dev / future public API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Session cookie (staff-login milestone; embedded app itself doesn't use this) ---
SESSION_SECURE_COOKIE=true

# --- Error tracking (App\Exceptions\Handlers\ApiExceptionRenderer's reportable() hook) ---
ERROR_TRACKING_DRIVER=
ERROR_TRACKING_DSN=

# --- Horizon dashboard ---
HORIZON_PATH=horizon
HORIZON_PREFIX=

# --- Database backups (docs/BACKUP_AND_RECOVERY.md) ---
# A separate bucket/credentials from AWS_* above is recommended (tighter
# access policy — write-only from the backup host, no public read).
# NOT required for local development; leave blank until a real backup
# destination is provisioned.
BACKUP_GPG_RECIPIENT=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=
BACKUP_AWS_BUCKET=
